        android:pathData="M54,21 L54,24 M54,84 L54,87 M21,54 L24,54 M84,54 L87,54 M31,31 L33.5,33.5 M77,77 L74.5,74.5 M31,77 L33.5,74.5 M77,31 L74.5,33.5"
