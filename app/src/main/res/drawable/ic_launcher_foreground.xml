                android:startX="40"
                android:startY="39"
                android:endX="68"
                android:endY="69"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#7C3AED" android:offset="0.7" />
                <item android:color="#D946EF" android:offset="1.0" />
