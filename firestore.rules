rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // User Accounts - Sensitive financial data locked to server/admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can only update non-financial fields (displayName, avatar)
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['availableBalance', 'pendingBalance', 'role', 'status', 'totalEarnings', 'matchesWon', 'totalGames']);
      allow write: if isAdmin();
    }

    // Public Profiles - Read-only for match opponents and leaderboard
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Matchmaking Queue
    match /matchQueue/{queueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Matches - Authoritative match state maintained by Cloud Functions / Admin
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Transactions Ledger - Read-only to owner, writable solely by authoritative backend
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Deposit Requests - Users submit UTR, Admin marks completed
    match /depositRequests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if isAdmin();
    }

    // Withdrawal Requests - Users submit payout request, Admin approves/settles
    match /withdrawalRequests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{noteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid; // e.g. mark read
      allow write: if isAdmin();
    }

    // Support Tickets
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // App Configuration & Banners - Public read, Admin write
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Administrative Audit Logs - Immutable
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
